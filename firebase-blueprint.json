{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Store customer order placed online or via WhatsApp",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "order_number": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "city": { "type": "string" },
        "department": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "origin": { "type": "string" },
        "payment_method": { "type": "string" },
        "delivery_method": { "type": "string" },
        "items": { "type": "array" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "order_number", "customer_name", "total", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product with pricing, stock and active status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "active": { "type": "boolean" },
        "main_image": { "type": "string" },
        "brand_name": { "type": "string" },
        "category_name": { "type": "string" }
      },
      "required": ["id", "name", "price", "stock", "active"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Public and admin orders collection"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store products collection"
    }
  }
}
